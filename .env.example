APP_NAME=Interview Prep Platform API
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
DATABASE_URL=postgresql+asyncpg://interview_prep:interview_prep@postgres:5432/interview_prep
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=resumes
S3_REGION=ap-south-1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=text-embedding-3-small
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000/api/v1/integrations
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

